# Normalize line endings in the repo; check out with the platform's native endings.
* text=auto

# Windows scripts need CRLF; shell scripts need LF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf

# Binary files
*.jpg  binary
*.jpeg binary
*.png  binary
*.mp4  binary
*.wav  binary
*.pdf  binary
