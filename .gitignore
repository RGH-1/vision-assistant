*.pth
*.onnx
*.safetensors
*.bin
*.gguf
mobileclip2_b.ts
.mobileclip2_b.ts.*.part

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- Node / dashboard ---
node_modules/
dashboard/dist/
*.tsbuildinfo
npm-debug.log*

# --- Flutter / Android ---
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/release/
*.jks
*.keystore
key.properties

