# Copy to .env and fill in. Never commit .env (design §8.3).
# Thresholds, intent weights and EVIDENCE_MIN live in server/config.yaml (in git).

DATABASE_URL=postgresql://va:va@localhost:5432/vision
# PostgreSQL Docker configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
RTSP_URL=rtsp://localhost:8554/phone
DATA_DIR=./data
RETENTION_MINUTES=30
SAMPLE_HZ=5

# Google AI Studio — each member uses their own key for development (design §10.2)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Groq — speech to text
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LOCAL_MODEL=medium

YOLOE_WEIGHTS=yoloe-26s-seg.pt
ALERTS_ENABLED=true
